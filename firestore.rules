rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Require Firebase Authentication for all reads and writes.
    // Paste these rules into Firebase Console → Firestore → Rules, then Publish.
    // They are NOT auto-deployed by this repo.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
