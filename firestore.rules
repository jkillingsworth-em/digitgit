rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: Draft policy. Do not deploy before provisioning admin claims,
    // verifying that employee accounts have verified corporate email addresses,
    // and testing all rules using the Firebase emulator.
    function isEmployee() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@electro-mech[.]com$');
    }

    function isAdmin() {
      return isEmployee() && request.auth.token.admin == true;
    }

    function validPendingCycleCount(countId) {
      return request.resource.data.keys().hasOnly([
          'id', 'locationId', 'startedAt', 'completedAt', 'countedBy',
          'blindMode', 'note', 'lines', 'posted', 'status'
        ])
        && request.resource.data.id == countId
        && request.resource.data.countedBy == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.posted == false
        && request.resource.data.locationId is string
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.lines.size() <= 400;
    }

    match /cycleCounts/{countId} {
      allow read: if isEmployee();
      allow create: if isAdmin() ||
        (isEmployee() && validPendingCycleCount(countId));
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }
  }
}
