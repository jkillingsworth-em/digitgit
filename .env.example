# Gemini (existing)
GEMINI_API_KEY=

# Google Sheets live sync (EM Digit Inventory)
# OAuth 2.0 Web client ID from Google Cloud Console (no secret needed for GIS token client)
VITE_GOOGLE_CLIENT_ID=
# Optional override; defaults to the shared EM Digit Inventory spreadsheet
VITE_EM_DIGIT_SHEET_ID=1sBtdqpGCWXTUd9KTKT5nF5mbG_r8KSIICvFlzizTbmw

# Firebase Auth domain allowlist (comma-separated). If set, only these email domains may sign in.
# Example: electro-mech.com
# If unset, any authenticated Firebase user is allowed.
VITE_ALLOWED_EMAIL_DOMAINS=electro-mech.com
